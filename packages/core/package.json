{
  "name": "@ai-ins/core",
  "version": "0.4.1",
  "description": "Core runtime for AI Ins bundler plugins.",
  "author": "Rongding Wang <wangrongding@qq.com> (https://github.com/wangrongding)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangrongding/ai-ins.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/wangrongding/ai-ins/issues"
  },
  "homepage": "https://github.com/wangrongding/ai-ins/tree/main/packages/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:client": "esbuild src/client-panel/runtime.tsx --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=src/client/react-panel.generated.js",
    "dev:client": "esbuild src/client-panel/runtime.tsx --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=src/client/react-panel.generated.js --watch",
    "copy-client": "node scripts/copy-client.mjs",
    "build": "pnpm build:client && tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --shims && pnpm copy-client",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
