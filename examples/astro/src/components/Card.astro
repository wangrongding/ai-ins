---
interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="card">
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .card {
    padding: 20px 24px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 8%);
  }

  h2 {
    margin: 0 0 12px;
    font-size: 18px;
  }
</style>
